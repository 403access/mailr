# Mailr local account setup
#
# Copy this file to .env, then fill in one block per mailbox.
# .env is git-ignored so credentials never enter the repository.
#
# Only EMAIL is required. Mailr infers gmail/icloud/yahoo/fastmail/zoho from
# the address; set PROVIDER=custom (or another provider) and the IMAP/SMTP
# hosts for a domain that is not recognised. Passwords are moved into the
# macOS/iOS Keychain at launch and are never written to the account database.
#
# The process environment overrides values in this file, and MAILR_ENV_FILE
# can point at a different .env file:
#   MAILR_ENV_FILE=/absolute/path/to/another.env

# ---------------------------------------------------------------- Gmail -----
# MAILR_ACCOUNT_GMAIL_EMAIL=you@gmail.com
# MAILR_ACCOUNT_GMAIL_PASSWORD="your google app password"
# MAILR_ACCOUNT_GMAIL_NAME=Personal
# MAILR_ACCOUNT_GMAIL_PROVIDER=gmail

# ---------------------------------------------------------------- iCloud ----
# MAILR_ACCOUNT_ICLOUD_EMAIL=you@icloud.com
# MAILR_ACCOUNT_ICLOUD_PASSWORD="your app-specific password"
# MAILR_ACCOUNT_ICLOUD_NAME=Personal
# MAILR_ACCOUNT_ICLOUD_PROVIDER=icloud

# --------------------------------------------------------------- Fastmail ---
# MAILR_ACCOUNT_FASTMAIL_EMAIL=you@fastmail.com
# MAILR_ACCOUNT_FASTMAIL_PASSWORD="your app password"
# MAILR_ACCOUNT_FASTMAIL_NAME=Work
# MAILR_ACCOUNT_FASTMAIL_PROVIDER=fastmail

# --------------------------------------------------------- Custom server ----
# Replace every value below. Custom accounts must provide both server hosts.
# MAILR_ACCOUNT_LOCAL_EMAIL=you@example.com
# MAILR_ACCOUNT_LOCAL_PASSWORD="your password"
# MAILR_ACCOUNT_LOCAL_NAME=Local Mail
# MAILR_ACCOUNT_LOCAL_PROVIDER=custom
#
# MAILR_ACCOUNT_LOCAL_IMAP_HOST=imap.example.com
# MAILR_ACCOUNT_LOCAL_IMAP_PORT=993
# MAILR_ACCOUNT_LOCAL_IMAP_SECURITY=tls
# MAILR_ACCOUNT_LOCAL_IMAP_USERNAME=you@example.com
#
# MAILR_ACCOUNT_LOCAL_SMTP_HOST=smtp.example.com
# MAILR_ACCOUNT_LOCAL_SMTP_PORT=465
# MAILR_ACCOUNT_LOCAL_SMTP_SECURITY=tls
# MAILR_ACCOUNT_LOCAL_SMTP_USERNAME=you@example.com
#
# Optional: pin an account UUID so it keeps the same Keychain entry and local
# cache when you rename the block.
# MAILR_ACCOUNT_LOCAL_ID=00000000-0000-4000-8000-000000000000

# ------------------------------------------------------- Host archive -----
# Optional: store every message the client retrieves in Mailr's host archive.
# Start the server with `make server` (loopback on 127.0.0.1:8787 by default).
# The macOS app and iOS Simulator can use this default. On a physical iPhone,
# use the Mac's LAN address and start the server with `--host 0.0.0.0`.
# MAILR_HOST_SERVER=http://127.0.0.1:8787
# Set to `off` to disable host syncing entirely.
# MAILR_HOST_SERVER=off

# Provider values: icloud, gmail, yahoo, fastmail, zoho, custom, demo.
# Security values: tls (implicit TLS, port 993/465) or plaintext (local
# development servers only).
